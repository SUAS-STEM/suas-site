[Unit]
Description=Deploy latest GitHub-built SUAS production artifact
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/pi/suas-site
Environment=WARM_CACHE_JOBS=6
ExecStart=/home/pi/suas-site/deploy/deploy-actions-artifact.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=4min
