{
  "name": "suas-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "fetch:internal": "node scripts/fetch-internal.mjs",
    "predev": "npm run fetch:internal && npm run gallery:manifest",
    "prebuild": "npm run fetch:internal && npm run gallery:manifest",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "rm -rf .next/standalone/public .next/standalone/.next/static && cp -r public .next/standalone/public && mkdir -p .next/standalone/.next && cp -r .next/static .next/standalone/.next/static",
    "start": "next start",
    "lint": "eslint",
    "gallery:manifest": "node scripts/generate-gallery-manifest.mjs"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "exifr": "^7.1.3",
    "firebase": "^12.13.0",
    "framer-motion": "^12.23.24",
    "fuse.js": "^7.5.0",
    "next": "^16.2.6",
    "next-page-transitions": "^1.0.0-beta.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.10.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
